# College Complaint Management System Environment Variables Template

# Application Server Port (Default: 3000)
PORT=3000

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/college_complaint_db
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/college_complaint_db
MONGODB_URI=mongodb://localhost:27017/college_complaint_db

# Secret key used for signing JWT Authentication tokens
JWT_SECRET=college_complaint_mgmt_secret_key_2026

# Google Gemini AI API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
